# ==========================================
# SERVER CONFIGURATION
# ==========================================
# The port the local simulation server listens on.
PORT=8080

# ==========================================
# CALLBACK & WEBHOOK SETTINGS
# ==========================================
# The endpoint where webhook notifications and payment updates will be sent.
SOLARIS_CALLBACK_URL=http://localhost:3000/your-real-callback-route

# Simulated network/processing delay (in milliseconds) before firing the callback.
CALLBACK_DELAY_MS=2000

# Behavior mode for callbacks (e.g., normal, delayed, or error simulation).
CALLBACK_MODE=normal

# Maximum number of retry attempts if a callback request fails or times out.
MAX_CALLBACK_ATTEMPTS=3

# Timeout threshold (in milliseconds) for an individual callback HTTP request.
CALLBACK_TIMEOUT_MS=5000

# Whether to introduce randomized network latency jitter (true/false).
SIMULATE_LATENCY=false


# ==========================================
# SECURITY & AUTHENTICATION SECRETS
# ==========================================
# Cryptographic secret used to sign and verify webhook payloads (min. 32 characters).
SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters

# API key required by external services or developers to trigger/interact with the simulator.
DEV_API_KEY=replace-with-another-random-secret-at-least-32-characters